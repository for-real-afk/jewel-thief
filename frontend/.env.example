# Local dev default. In Vercel, set these in Project Settings -> Environment
# Variables (not in a committed file) — VITE_API_BASE should be the deployed
# Render backend's URL, e.g. https://jewel-thief-backend.onrender.com
VITE_API_BASE=http://localhost:8000

# NOTE: Vite bakes every VITE_* var into the public JS bundle at build time.
# This is NOT a real secret once deployed — anyone can read it from the
# browser's network tab or bundled source. It only needs to match the
# backend's APP_API_KEY closely enough to stop trivial/accidental abuse of
# an unauthenticated URL, not to gate a determined attacker. Don't reuse a
# genuinely sensitive credential here.
VITE_API_KEY=replace-with-a-real-secret
