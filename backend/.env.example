GEMINI_API_KEY=your-gemini-api-key
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
RERANKER_MODEL=gemini-2.5-flash

# Embedding is always Gemini — the only provider here with an image-embedding
# endpoint. LLM_PROVIDER (reranker judge only) is "gemini" or "groq".
LLM_PROVIDER=gemini

GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_CHAT_TIMEOUT_SECONDS=60

PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=jewellery-catalog
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

TOP_K=20
MIN_SIMILARITY_THRESHOLD=0.55
MIN_SIMILARITY_THRESHOLD_TEXT=0.35

APP_API_KEY=replace-with-a-real-secret

# Comma-separated exact origins. In production, set this to the deployed
# Vercel URL(s), e.g. https://jewel-thief.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# Optional: regex for origins that vary per-deploy, so Vercel preview URLs
# (a new one per branch/PR) don't each need adding to ALLOWED_ORIGINS by
# hand. Leave blank to disable. Example for a Vercel project named
# "jewel-thief": ALLOWED_ORIGIN_REGEX=https://jewel-thief.*\.vercel\.app
ALLOWED_ORIGIN_REGEX=
