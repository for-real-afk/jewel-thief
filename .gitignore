# Secrets — never commit real environment files, only the .example templates
.env
.env.*
!.env.example
!*.env.example

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
*.egg-info/

# Node / frontend build output
node_modules/
dist/

# backend/app/static/catalog/ and backend/catalog_store.json are INTENTIONALLY
# tracked, not ignored — see the "Catalog images are committed" section in
# README.md/DEPLOYMENT.md. Render's disk is ephemeral, so anything written
# only at runtime vanishes on every restart; committing them bakes the
# current catalog into the deploy itself instead of relying on local state.

# Raw fetched source material for backend/scripts/fetch_sample_images.py —
# regenerable, not needed at runtime (only backend/app/static/catalog/ is
# actually served).
backend/sample_data/

# Logs
*.log

# OS cruft
.DS_Store
Thumbs.db
